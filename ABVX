                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                        local val = math.floor(min + (max - min) * pos)
                        fill.Size = UDim2.new(pos, 0, 1, 0)
                        title.Text = labelName .. ": " .. val
                        callback(val)
                    end
                end)
            end

            createButton(tabMisc, "Speed Toggle: OFF", function(btn)
                getgenv().CrackThis.Misc.SpeedEnabled = not getgenv().CrackThis.Misc.SpeedEnabled
                btn.Text = getgenv().CrackThis.Misc.SpeedEnabled and "Speed Toggle: ON" or "Speed Toggle: OFF"
            end)

            createSlider(tabMisc, "WalkSpeed", 16, 200, 16, function(val)
                getgenv().CrackThis.Misc.SpeedValue = val
            end)

            createButton(tabMisc, "Jump Toggle: OFF", function(btn)
                getgenv().CrackThis.Misc.JumpEnabled = not getgenv().CrackThis.Misc.JumpEnabled
                btn.Text = getgenv().CrackThis.Misc.JumpEnabled and "Jump Toggle: ON" or "Jump Toggle: OFF"
            end)

            createSlider(tabMisc, "JumpPower", 50, 300, 50, function(val)
                getgenv().CrackThis.Misc.JumpValue = val
            end)

            -- ==========================================
            -- TAB 4: ESP (Red and Black Rainbow style)
            -- ==========================================
            createButton(tabEsp, "ESP Tracers: OFF", function(btn)
                getgenv().CrackThis.ESP.Tracers = not getgenv().CrackThis.ESP.Tracers
                btn.Text = getgenv().CrackThis.ESP.Tracers and "ESP Tracers: ON" or "ESP Tracers: OFF"
            end)

            createButton(tabEsp, "Hitbox / Chams: OFF", function(btn)
                getgenv().CrackThis.ESP.Hitbox = not getgenv().CrackThis.ESP.Hitbox
                btn.Text = getgenv().CrackThis.ESP.Hitbox and "Hitbox / Chams: ON" or "Hitbox / Chams: OFF"
            end)

            createButton(tabEsp, "Skeleton ESP: OFF", function(btn)
                getgenv().CrackThis.ESP.Skeleton = not getgenv().CrackThis.ESP.Skeleton
                btn.Text = getgenv().CrackThis.ESP.Skeleton and "Skeleton ESP: ON" or "Skeleton ESP: OFF"
            end)

            createButton(tabEsp, "Display Name ESP: OFF", function(btn)
                getgenv().CrackThis.ESP.DisplayName = not getgenv().CrackThis.ESP.DisplayName
                btn.Text = getgenv().CrackThis.ESP.DisplayName and "Display Name ESP: ON" or "Display Name ESP: OFF"
            end)

            createButton(tabEsp, "Self ESP (Always ON): ON", function(btn)
                getgenv().CrackThis.ESP.SelfESP = not getgenv().CrackThis.ESP.SelfESP
                btn.Text = getgenv().CrackThis.ESP.SelfESP and "Self ESP (Always ON): ON" or "Self ESP: OFF"
            end)

            -- Universal Target Verification Utility (Players + Bots support)
            local function isValidTarget(char)
                if not char or char == LocalPlayer.Character then 
                    if getgenv().CrackThis.ESP.SelfESP then return true end
                    return false 
                end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then return false end

                local tType = getgenv().CrackThis.Aiming.TargetType or "Both"
                local isPlayer = Players:GetPlayerFromCharacter(char) ~= nil

                if tType == "Players" and not isPlayer then return false end
                if tType == "Bots" and isPlayer then return false end
                return true
            end

            -- Main Loop for Speed/Jump and ESP Red-Black Rainbow Effects
            local rainbowHue = 0
            RunService.RenderStepped:Connect(function(dt)
                pcall(function()
                    rainbowHue = (rainbowHue + dt * 0.5) % 1
                    local rainbowColor = Color3.fromHSV(0, 1, math.abs(math.sin(tick() * 3))) -- Red & Black vibe

                    -- Misc WalkSpeed & JumpPower Enforcement
                    local char = LocalPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            if getgenv().CrackThis.Misc.SpeedEnabled then
                                hum.WalkSpeed = getgenv().CrackThis.Misc.SpeedValue
                            end
                            if getgenv().CrackThis.Misc.JumpEnabled then
                                hum.JumpPower = getgenv().CrackThis.Misc.JumpValue
                                hum.UseJumpPower = true
                            end
                        end
                    end

                    -- ESP Red and Black Chams / Highlighting execution
                    for _, p in ipairs(Players:GetPlayers()) do
                        local c = p.Character
                        if c and (isValidTarget(c) or (p == LocalPlayer and getgenv().CrackThis.ESP.SelfESP)) then
                            local highlight = c:FindFirstChild("AbvxRainbowESP")
                            if getgenv().CrackThis.ESP.Hitbox then
                                if not highlight then
                                    highlight = Instance.new("Highlight")
                                    highlight.Name = "AbvxRainbowESP"
                                    highlight.Adornee = c
                                    highlight.Parent = c
                                end
                                highlight.FillColor = Color3.fromRGB(20, 0, 0)
                                highlight.OutlineColor = rainbowColor
                                highlight.FillTransparency = 0.5
                                highlight.OutlineTransparency = 0
                            else
                                if highlight then highlight:Destroy() end
                            end
                        end
                    end
                end)
            end)

            print("✅ ABVX UNIVERSAL MULTI-METHOD HUB LOADED SUCCESSFULLY!")
        end
    end
end)

