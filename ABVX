            local infoBgImage = Instance.new("ImageLabel", topInfoFrame)
            infoBgImage.Size = UDim2.new(1, 0, 1, 0)
            infoBgImage.BackgroundTransparency = 1
            infoBgImage.Image = "rbxassetid://76550748284492"
            infoBgImage.ScaleType = Enum.ScaleType.Slice
            infoBgImage.SliceCenter = Rect.new(100, 100, 100, 100)
            infoBgImage.ZIndex = topInfoFrame.ZIndex - 1

            local infoCorner = Instance.new("UICorner", topInfoFrame)
            infoCorner.CornerRadius = UDim.new(0, 8)

            local infoStroke = Instance.new("UIStroke", topInfoFrame)
            infoStroke.Thickness = 2
            infoStroke.Color = Color3.fromRGB(255, 0, 0)

            local targetAvatar = Instance.new("ImageLabel", topInfoFrame)
            targetAvatar.Size = UDim2.new(0, 45, 0, 45)
            targetAvatar.Position = UDim2.new(0, 5, 0, 5)
            targetAvatar.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
            targetAvatar.Image = ""
            
            local avatarCorner = Instance.new("UICorner", targetAvatar)
            avatarCorner.CornerRadius = UDim.new(0, 6)

            local topInfoLabel = Instance.new("TextLabel", topInfoFrame)
            topInfoLabel.Size = UDim2.new(1, -55, 1, 0)
            topInfoLabel.Position = UDim2.new(0, 55, 0, 0)
            topInfoLabel.BackgroundTransparency = 1
            topInfoLabel.TextColor3 = Color3.fromRGB(255, 220, 220)
            topInfoLabel.TextSize = 12
            topInfoLabel.Font = Enum.Font.GothamBold
            topInfoLabel.TextXAlignment = Enum.TextXAlignment.Left
            topInfoLabel.TextWrapped = true
            topInfoLabel.Text = "TARGET: NONE"

            local tracerFrame = Instance.new("Frame", screenGui)
            tracerFrame.Name = "TracerLine"
            tracerFrame.AnchorPoint = Vector2.new(0.5, 0.5)
            tracerFrame.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
            tracerFrame.BorderSizePixel = 0
            tracerFrame.Visible = false

            local currentTargetModel = nil
            local lockedHitPart = nil
            local smoothedPosition = Vector3.new(0, 0, 0)

            local function isValidTarget(char)
                if not char or char == LocalPlayer.Character then return false end
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if not humanoid or humanoid.Health <= 0 then return false end
                
                local player = Players:GetPlayerFromCharacter(char)
                if player then
                    return true
                else
                    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
                    if root then
                        return true
                    end
                end
                return false
            end

            local function getTarget()
                local bestTarget = nil
                local bestMetric = math.huge
                local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

                local function evaluate(char)
                    if isValidTarget(char) then
                        local targetPart = char:FindFirstChild(config.Aiming.HitPart) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
                        if targetPart then
                            local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                            if onScreen then
                                local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                                local distFromCenter = (screenPos2D - screenCenter).Magnitude
                                
                                if distFromCenter <= config.Aiming.FOV then
                                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                                    if distFromCenter < bestMetric then
                                        bestMetric = distFromCenter
                                        bestTarget = char
                                    end
                                end
                            end
                        end
                    end
                end

                pcall(function()
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p.Character then evaluate(p.Character) end
                    end
                    for _, obj in ipairs(workspace:GetChildren()) do
                        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                            evaluate(obj)
                        end
                    end
                end)

                return bestTarget
            end

            local frameCounter = 0
            RunService.RenderStepped:Connect(function(dt)
                pcall(function()
                    frameCounter = frameCounter + 1

                    local char = LocalPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            if config.Misc.SpeedEnabled then
                                hum.WalkSpeed = config.Misc.SpeedValue
                            end
                            if config.Misc.JumpEnabled then
                                hum.JumpPower = config.Misc.JumpValue
                            end
                        end
                    end

                    if config.ESP.SelfESP and char then
                        local timeTick = tick() * 2
                        local rainbowColor = Color3.fromRGB(
                            math.floor(math.sin(timeTick) * 127 + 128),
                            0,
                            math.floor(math.cos(timeTick) * 127 + 128)
                        )
                        for _, part in ipairs(char:GetChildren()) do
                            if part:IsA("BasePart") then
                                local handle = part:FindFirstChild("ABVX_SelfChams")
                                if not handle then
                                    handle = Instance.new("BoxHandleAdornment")
                                    handle.Name = "ABVX_SelfChams"
                                    handle.Adornee = part
                                    handle.AlwaysOnTop = true
                                    handle.ZIndex = 10
                                    handle.Size = part.Size + Vector3.new(0.05, 0.05, 0.05)
                                    handle.Parent = part
                                end
                                handle.Color3 = rainbowColor
                                handle.Transparency = 0.3
                            end
                        end
                    else
                        if char then
                            for _, part in ipairs(char:GetChildren()) do
                                if part:IsA("BasePart") then
                                    local handle = part:FindFirstChild("ABVX_SelfChams")
                                    if handle then handle:Destroy() end
                                end
                            end
                        end
                    end

                    local aimingCfg = config.Aiming
                    
                    -- Only run targeting loop if either Silent Aim or Camlock Active is ON
                    if not aimingCfg.Enabled and not aimingCfg.CamlockActive then
                        currentTargetModel = nil
                        lockedHitPart = nil
                        fovCircleFrame.Visible = false
                        topInfoFrame.Visible = false
                        tracerFrame.Visible = false
                        return
                    end

                    fovCircleFrame.Visible = aimingCfg.FOVCircle

                    if aimingCfg.CamlockEnabled and aimingCfg.CamlockActive and currentTargetModel then
                        local hum = currentTargetModel:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health <= 0 then
                            currentTargetModel = nil
                            lockedHitPart = nil
                        else
                            local partName = aimingCfg.HitPart or "HumanoidRootPart"
                            lockedHitPart = currentTargetModel:FindFirstChild(partName) or currentTargetModel:FindFirstChild("HumanoidRootPart") or currentTargetModel:FindFirstChild("Head")
                        end
                    else
                        currentTargetModel = getTarget()
                        if currentTargetModel then
                            local partName = aimingCfg.HitPart or "HumanoidRootPart"
                            lockedHitPart = currentTargetModel:FindFirstChild(partName) or currentTargetModel:FindFirstChild("HumanoidRootPart") or currentTargetModel:FindFirstChild("Head")
                        else
                            lockedHitPart = nil
                        end
                    end

                    if aimingCfg.CamlockEnabled and aimingCfg.CamlockActive and currentTargetModel and lockedHitPart then
                        local camTargetPos = lockedHitPart.Position
                        local currentCamPos = camera.CFrame.Position
                        if aimingCfg.Smoothness > 0 then
                            camera.CFrame = camera.CFrame:Lerp(CFrame.new(currentCamPos, camTargetPos), math.clamp(dt * (1 / aimingCfg.Smoothness * 10), 0.1, 1))
                        else
                            camera.CFrame = CFrame.new(currentCamPos, camTargetPos)
                        end
                    end

                    if currentTargetModel and lockedHitPart then
                        fovStroke.Color = Color3.fromRGB(0, 255, 0)

                        local rawTargetPos = lockedHitPart.Position
                        local linearVelocity = lockedHitPart.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
                        local pred = aimingCfg.Prediction and (aimingCfg.PredictionVal or 0.03) or 0
                        smoothedPosition = rawTargetPos + Vector3.new(linearVelocity.X * pred, linearVelocity.Y * pred, linearVelocity.Z * pred)

                        local humanoid = currentTargetModel:FindFirstChildOfClass("Humanoid")
                        local rootPart = currentTargetModel:FindFirstChild("HumanoidRootPart") or lockedHitPart
                        
                        if humanoid then
                            local distanceMeters = 0
                            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                distanceMeters = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude / 3.5)
                            end

                            local targetPlayer = Players:GetPlayerFromCharacter(currentTargetModel)
                            local nameStr = targetPlayer and targetPlayer.DisplayName or currentTargetModel.Name

                            if aimingCfg.ShowInfo then
                                topInfoLabel.Text = string.format("NAME: %s\nHP: %d/%d | DIST: %dm\nPART: %s", nameStr, math.floor(humanoid.Health), math.floor(humanoid.MaxHealth), distanceMeters, lockedHitPart.Name)
                                
                                if targetPlayer and (frameCounter % 30 == 0) then
                                    pcall(function()
                                        local thumb = Players:GetUserThumbnailAsync(targetPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                                        if thumb then targetAvatar.Image = thumb end
                                    end)
                                elseif not targetPlayer then
                                    targetAvatar.Image = "rbxassetid://110314637434659"
                                end
                                topInfoFrame.Visible = true
                            else
                                topInfoFrame.Visible = false
                            end

                            if aimingCfg.ShowTracers then
                                local screenPos, onScreen = camera:WorldToViewportPoint(smoothedPosition)
                                if onScreen then
                                    local screenCenterBottom = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                                    local targetPos2D = Vector2.new(screenPos.X, screenPos.Y)
                                    local dist2D = (targetPos2D - screenCenterBottom).Magnitude
                                    local midpoint = (screenCenterBottom + targetPos2D) / 2
                                    
                                    tracerFrame.Size = UDim2.new(0, dist2D, 0, 2)
                                    tracerFrame.Position = UDim2.new(0, midpoint.X, 0, midpoint.Y)
                                    tracerFrame.Rotation = math.deg(math.atan2(targetPos2D.Y - screenCenterBottom.Y, targetPos2D.X - screenCenterBottom.X))
                                    tracerFrame.Visible = true
                                else
                                    tracerFrame.Visible = false
                                end
                            else
                                tracerFrame.Visible = false
                            end
                        else
                            lockedHitPart = nil
                            currentTargetModel = nil
                            topInfoFrame.Visible = false
                            tracerFrame.Visible = false
                        end
                    else
                        fovStroke.Color = Settings.CircleColor
                        topInfoFrame.Visible = false
                        tracerFrame.Visible = false
                        smoothedPosition = Vector3.new(0, 0, 0)
                    end
                end)
            end)

            local function getTargetPosition()
                if not lockedHitPart then
                    return Vector3.new()
                end
                if smoothedPosition == Vector3.new(0, 0, 0) then
                    return lockedHitPart.Position
                end
                return smoothedPosition
            end

            pcall(function()
                local oldRaycast
                oldRaycast = hookfunction(workspace.Raycast, function(ws, origin, direction, raycastParams)
                    if config.Aiming.Enabled and lockedHitPart then
                        local mode = config.Aiming.MethodMode or "Raycast"
                        if mode == "Raycast" or mode == "All" then
                            local originPos = (typeof(origin) == "Vector3") and origin or camera.CFrame.Position
                            local targetPos = getTargetPosition()
                            local newDirection = (targetPos - originPos)
                            return oldRaycast(ws, originPos, newDirection, raycastParams)
                        end
                    end
                    return oldRaycast(ws, origin, direction, raycastParams)
                end)
            end)

            pcall(function()
                local mt = getrawmetatable(game)
                setreadonly(mt, false)
                local oldNamecall = mt.__namecall

                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    local args = {...}

                    if config.Aiming.Enabled and lockedHitPart then
                        local mode = config.Aiming.MethodMode or "Raycast"
                        if mode == "Namecall" or mode == "Framework" or mode == "All" then
                            if method == "FireServer" or method == "InvokeServer" then
                                local targetPos = getTargetPosition()
                                for i, arg in ipairs(args) do
                                    local t = typeof(arg)
                                    if t == "Vector3" then
                                        args[i] = targetPos
                                    elseif t == "CFrame" then
                                        args[i] = CFrame.new(arg.Position, targetPos)
                                    elseif t == "table" then
                                        for k, v in pairs(arg) do
                                            if typeof(v) == "Vector3" then
                                                arg[k] = targetPos
                                            elseif typeof(v) == "CFrame" then
                                                arg[k] = CFrame.new(v.Position, targetPos)
                                            end
                                        end
                                    end
                                end
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end

                    return oldNamecall(self, ...)
                end)
            end)
        end
    end
end)

