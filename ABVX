            infoStroke.Color = Color3.fromRGB(60, 60, 60)

            local targetAvatar = Instance.new("ImageLabel", topInfoFrame)
            targetAvatar.Size = UDim2.new(0, 40, 0, 40)
            targetAvatar.Position = UDim2.new(0, 5, 0, 5)
            targetAvatar.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            targetAvatar.Image = ""
            
            local avatarCorner = Instance.new("UICorner", targetAvatar)
            avatarCorner.CornerRadius = UDim.new(0, 4)

            local topInfoLabel = Instance.new("TextLabel", topInfoFrame)
            topInfoLabel.Size = UDim2.new(1, -50, 1, 0)
            topInfoLabel.Position = UDim2.new(0, 50, 0, 0)
            topInfoLabel.BackgroundTransparency = 1
            topInfoLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            topInfoLabel.TextSize = 11
            topInfoLabel.Font = Enum.Font.Code
            topInfoLabel.TextXAlignment = Enum.TextXAlignment.Left
            topInfoLabel.TextWrapped = true
            topInfoLabel.Text = "TARGET: NONE"

            local tracerFrame = Instance.new("Frame", screenGui)
            tracerFrame.Name = "TracerLine"
            tracerFrame.AnchorPoint = Vector2.new(0.5, 0.5)
            tracerFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            tracerFrame.BorderSizePixel = 0
            tracerFrame.Visible = false

            local currentTargetModel = nil
            local lockedHitPart = nil
            local smoothedPosition = Vector3.new(0, 0, 0)

            -- ==================================================
            -- ADVANCED TARGET & FOLDER SCANNER (Bots_1 to Bots_10, Folders "Bots" / "Bot")
            -- ==================================================
            local function isValidTarget(char)
                if not char or char == LocalPlayer.Character then return false end
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if not humanoid or humanoid.Health <= 0 then return false end
                
                local player = Players:GetPlayerFromCharacter(char)
                if player then
                    return true
                else
                    local name = char.Name:lower()
                    -- Match specific requested ranges and keywords: Bots_1 through Bots_10, generic bots, dummies, etc.
                    if name:match("bot") or name:match("dummy") or name:match("target") or char:FindFirstChild("HumanoidRootPart") then
                        return true
                    end
                end
                return false
            end

            local function getTarget()
                local bestTarget = nil
                local bestMetric = math.huge
                local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

                local function evaluate(char)
                    if isValidTarget(char) then
                        local targetPart = char:FindFirstChild(config.Aiming.HitPart) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
                        if targetPart then
                            local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                            if onScreen then
                                local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                                local distFromCenter = (screenPos2D - screenCenter).Magnitude
                                
                                if distFromCenter <= config.Aiming.FOV then
                                    if distFromCenter < bestMetric then
                                        bestMetric = distFromCenter
                                        bestTarget = char
                                    end
                                end
                            end
                        end
                    end
                end

                pcall(function()
                    -- 1. Scan Players
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p.Character then evaluate(p.Character) end
                    end

                    -- 2. Scan Workspace Dummies and direct entities
                    for _, obj in ipairs(workspace:GetChildren()) do
                        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                            evaluate(obj)
                        end
                    end

                    -- 3. Check for specific named structures like Bots_1 through Bots_10 or folders named "Bots" / "Bot"
                    for _, descendant in ipairs(workspace:GetDescendants()) do
                        if descendant:IsA("Folder") then
                            local fname = descendant.Name:lower()
                            if fname == "bots" or fname == "bot" or fname:match("bot_") then
                                for _, child in ipairs(descendant:GetChildren()) do
                                    if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
                                        evaluate(child)
                                    end
                                end
                            end
                        end
                    end
                end)

                return bestTarget
            end

            local espCache = {}

            local function clearESP()
                for _, data in pairs(espCache) do
                    if data.Highlight then data.Highlight:Destroy() end
                    if data.Billboard then data.Billboard:Destroy() end
                    if data.BoxFrame then data.BoxFrame:Destroy() end
                    if data.TraceLine then data.TraceLine:Destroy() end
                end
                espCache = {}
            end

            local function getThemeColors()
                local t = config.ESP.Theme
                if t == "Light" then
                    return Color3.fromRGB(240, 240, 240), Color3.fromRGB(200, 200, 200)
                elseif t == "Red" then
                    return Color3.fromRGB(255, 50, 50), Color3.fromRGB(150, 0, 0)
                elseif t == "Black" then
                    return Color3.fromRGB(20, 20, 20), Color3.fromRGB(0, 0, 0)
                elseif t == "Rainbow" then
                    local tickVal = tick() * 2
                    local col = Color3.fromHSV(tickVal % 1, 1, 1)
                    return col, col
                else -- Dark (Default)
                    return Color3.fromRGB(30, 30, 30), Color3.fromRGB(15, 15, 15)
                end
            end

            local frameCounter = 0
            RunService.RenderStepped:Connect(function(dt)
                pcall(function()
                    frameCounter = frameCounter + 1

                    local char = LocalPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            if config.Misc.SpeedEnabled then
                                hum.WalkSpeed = config.Misc.SpeedValue
                            end
                            if config.Misc.JumpEnabled then
                                hum.JumpPower = config.Misc.JumpValue
                            end
                        end
                    end

                    -- Hide FOV circle when camlocked, display only when enabled and not locked
                    if config.Aiming.CamlockActive or not config.Aiming.FOVCircle then
                        fovCircleFrame.Visible = false
                    else
                        fovCircleFrame.Visible = true
                        local col1, _ = getThemeColors()
                        fovStroke.Color = col1
                    end

                    -- ESP Renderer (Box, Health, Trace, Display Name, Custom Themes)
                    if config.ESP.Enabled then
                        local activeModels = {}
                        local primaryColor, outlineColor = getThemeColors()
                        
                        local function processModel(model)
                            if not isValidTarget(model) then return end
                            activeModels[model] = true
                            
                            local data = espCache[model]
                            if not data then
                                data = {}
                                
                                local hl = Instance.new("Highlight")
                                hl.Name = "ABVX_ESP_Highlight"
                                hl.Adornee = model
                                hl.FillTransparency = 0.6
                                hl.OutlineTransparency = 0.2
                                hl.Parent = CoreGui
                                data.Highlight = hl

                                local bb = Instance.new("BillboardGui")
                                bb.Name = "ABVX_ESP_Tag"
                                bb.Size = UDim2.new(0, 140, 0, 50)
                                bb.StudsOffset = Vector3.new(0, 3.2, 0)
                                bb.AlwaysOnTop = true
                                bb.Adornee = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
                                
                                local textLbl = Instance.new("TextLabel", bb)
                                textLbl.Size = UDim2.new(1, 0, 1, 0)
                                textLbl.BackgroundTransparency = 1
                                textLbl.Font = Enum.Font.Code
                                textLbl.TextSize = 11
                                textLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                                textLbl.TextStrokeTransparency = 0
                                data.TextLabel = textLbl
                                bb.Parent = CoreGui
                                data.Billboard = bb

                                local trLine = Instance.new("Frame", screenGui)
                                trLine.Name = "ESP_Trace"
                                trLine.AnchorPoint = Vector2.new(0.5, 0.5)
                                trLine.BorderSizePixel = 0
                                trLine.Visible = false
                                data.TraceLine = trLine

                                espCache[model] = data
                            end

                            if data.Highlight then
                                data.Highlight.Enabled = config.ESP.Box
                                data.Highlight.FillColor = primaryColor
                                data.Highlight.OutlineColor = outlineColor
                            end

                            if data.Billboard and data.TextLabel then
                                data.Billboard.Enabled = config.ESP.DisplayName or config.ESP.Health
                                local humanoid = model:FindFirstChildOfClass("Humanoid")
                                local plr = Players:GetPlayerFromCharacter(model)
                                local nameTxt = (config.ESP.DisplayName) and (plr and plr.DisplayName or model.Name) or ""
                                local hp = humanoid and math.floor(humanoid.Health) or 100
                                local hpTxt = config.ESP.Health and string.format("[%d HP]", hp) or ""
                                data.TextLabel.Text = nameTxt .. " " .. hpTxt
                                data.TextLabel.TextColor3 = primaryColor
                            end

                            if data.TraceLine then
                                if config.ESP.Trace then
                                    local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
                                    if rootPart then
                                        local screenPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
                                        if onScreen then
                                            local screenCenterBottom = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                                            local targetPos2D = Vector2.new(screenPos.X, screenPos.Y)
                                            local dist2D = (targetPos2D - screenCenterBottom).Magnitude
                                            local midpoint = (screenCenterBottom + targetPos2D) / 2
                                            
                                            data.TraceLine.Size = UDim2.new(0, dist2D, 0, 1.5)
                                            data.TraceLine.Position = UDim2.new(0, midpoint.X, 0, midpoint.Y)
                                            data.TraceLine.Rotation = math.deg(math.atan2(targetPos2D.Y - screenCenterBottom.Y, targetPos2D.X - screenCenterBottom.X))
                                            data.TraceLine.BackgroundColor3 = primaryColor
                                            data.TraceLine.Visible = true
                                        else
                                            data.TraceLine.Visible = false
                                        end
                                    else
                                        data.TraceLine.Visible = false
                                    end
                                else
                                    data.TraceLine.Visible = false
                                end
                            end
                        end

                        for _, p in ipairs(Players:GetPlayers()) do
                            if p.Character then processModel(p.Character) end
                        end
                        for _, obj in ipairs(workspace:GetChildren()) do
                            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                                processModel(obj)
                            end
                        end
                        for _, descendant in ipairs(workspace:GetDescendants()) do
                            if descendant:IsA("Folder") then
                                local fname = descendant.Name:lower()
                                if fname == "bots" or fname == "bot" or fname:match("bot_") then
                                    for _, child in ipairs(descendant:GetChildren()) do
                                        if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
                                            processModel(child)
                                        end
                                    end
                                end
                            end
                        end

                        for mdl, data in pairs(espCache) do
                            if not activeModels[mdl] or not mdl.Parent then
                                if data.Highlight then data.Highlight:Destroy() end
                                if data.Billboard then data.Billboard:Destroy() end
                                if data.TraceLine then data.TraceLine:Destroy() end
                                espCache[mdl] = nil
                            end
                        end
                    else
                        clearESP()
                    end

                    local aimingCfg = config.Aiming
                    
                    if not aimingCfg.Enabled and not aimingCfg.CamlockActive then
                        currentTargetModel = nil
                        lockedHitPart = nil
                        topInfoFrame.Visible = false
                        tracerFrame.Visible = false
                        return
                    end

                    if aimingCfg.CamlockEnabled and aimingCfg.CamlockActive and currentTargetModel then
                        local hum = currentTargetModel:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health <= 0 then
                            currentTargetModel = nil
                            lockedHitPart = nil
                        else
                            local partName = aimingCfg.HitPart or "HumanoidRootPart"
                            lockedHitPart = currentTargetModel:FindFirstChild(partName) or currentTargetModel:FindFirstChild("HumanoidRootPart") or currentTargetModel:FindFirstChild("Head")
                        end
                    else
                        currentTargetModel = getTarget()
                        if currentTargetModel then
                            local partName = aimingCfg.HitPart or "HumanoidRootPart"
                            lockedHitPart = currentTargetModel:FindFirstChild(partName) or currentTargetModel:FindFirstChild("HumanoidRootPart") or currentTargetModel:FindFirstChild("Head")
                        else
                            lockedHitPart = nil
                        end
                    end

                    if aimingCfg.CamlockEnabled and aimingCfg.CamlockActive and currentTargetModel and lockedHitPart then
                        local camTargetPos = lockedHitPart.Position
                        local currentCamPos = camera.CFrame.Position
                        if aimingCfg.Smoothness > 0 then
                            camera.CFrame = camera.CFrame:Lerp(CFrame.new(currentCamPos, camTargetPos), math.clamp(dt * (1 / aimingCfg.Smoothness * 10), 0.1, 1))
                        else
                            camera.CFrame = CFrame.new(currentCamPos, camTargetPos)
                        end
                    end

                    if currentTargetModel and lockedHitPart then
                        local rawTargetPos = lockedHitPart.Position
                        local linearVelocity = lockedHitPart.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
                        local pred = aimingCfg.Prediction and (aimingCfg.PredictionVal or 0.03) or 0
                        smoothedPosition = rawTargetPos + Vector3.new(linearVelocity.X * pred, linearVelocity.Y * pred, linearVelocity.Z * pred)

                        local humanoid = currentTargetModel:FindFirstChildOfClass("Humanoid")
                        local rootPart = currentTargetModel:FindFirstChild("HumanoidRootPart") or lockedHitPart
                        
                        if humanoid then
                            local distanceMeters = 0
                            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                distanceMeters = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude / 3.5)
                            end

                            local targetPlayer = Players:GetPlayerFromCharacter(currentTargetModel)
                            local nameStr = targetPlayer and targetPlayer.DisplayName or currentTargetModel.Name

                            if aimingCfg.ShowInfo then
                                topInfoLabel.Text = string.format("TARGET: %s\nHP: %d | DIST: %dm", nameStr, math.floor(humanoid.Health), distanceMeters)
                                
                                if targetPlayer and (frameCounter % 30 == 0) then
                                    pcall(function()
                                        local thumb = Players:GetUserThumbnailAsync(targetPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                                        if thumb then targetAvatar.Image = thumb end
                                    end)
                                elseif not targetPlayer then
                                    targetAvatar.Image = "rbxassetid://110314637434659"
                                end
                                topInfoFrame.Visible = true
                            else
                                topInfoFrame.Visible = false
                            end

                            if aimingCfg.ShowTracers then
                                local screenPos, onScreen = camera:WorldToViewportPoint(smoothedPosition)
                                if onScreen then
                                    local screenCenterBottom = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                                    local targetPos2D = Vector2.new(screenPos.X, screenPos.Y)
                                    local dist2D = (targetPos2D - screenCenterBottom).Magnitude
                                    local midpoint = (screenCenterBottom + targetPos2D) / 2
                                    
                                    tracerFrame.Size = UDim2.new(0, dist2D, 0, 1.5)
                                    tracerFrame.Position = UDim2.new(0, midpoint.X, 0, midpoint.Y)
                                    tracerFrame.Rotation = math.deg(math.atan2(targetPos2D.Y - screenCenterBottom.Y, targetPos2D.X - screenCenterBottom.X))
                                    tracerFrame.Visible = true
                                else
                                    tracerFrame.Visible = false
                                end
                            else
                                tracerFrame.Visible = false
                            end
                        else
                            lockedHitPart = nil
                            currentTargetModel = nil
                            topInfoFrame.Visible = false
                            tracerFrame.Visible = false
                        end
                    else
                        topInfoFrame.Visible = false
                        tracerFrame.Visible = false
                        smoothedPosition = Vector3.new(0, 0, 0)
                    end
                end)
            end)

            local function getTargetPosition()
                if not lockedHitPart then
                    return Vector3.new()
                end
                if smoothedPosition == Vector3.new(0, 0, 0) then
                    return lockedHitPart.Position
                end
                return smoothedPosition
            end

            -- ==================================================
            -- ALL HOOKS & ANTI-CHEAT BYPASS METHODS (Raycast, Viewport, Mouse, Parts)
            -- ==================================================
            pcall(function()
                local oldRaycast
                oldRaycast = hookfunction(workspace.Raycast, function(ws, origin, direction, raycastParams)
                    if config.Aiming.Enabled and lockedHitPart then
                        local mode = config.Aiming.MethodMode or "Raycast"
                        if mode == "Raycast" or mode == "All" then
                            local originPos = (typeof(origin) == "Vector3") and origin or camera.CFrame.Position
                            local targetPos = getTargetPosition()
                            local newDirection = (targetPos - originPos)
                            return oldRaycast(ws, originPos, newDirection, raycastParams)
                        end
                    end
                    return oldRaycast(ws, origin, direction, raycastParams)
                end)
            end)

            pcall(function()
                local oldFindPartOnRayWithIgnore
                oldFindPartOnRayWithIgnore = hookfunction(workspace.FindPartOnRayWithIgnoreList, function(ws, ray, ignoreList, terrainCellsAreCubes, ignoreWater)
                    if config.Aiming.Enabled and lockedHitPart then
                        local mode = config.Aiming.MethodMode or "Raycast"
                        if mode == "FindPartOnRayWithIgnore" or mode == "All" then
                            local targetPos = getTargetPosition()
                            local newRay = Ray.new(ray.Origin, (targetPos - ray.Origin).Unit * ray.Direction.Magnitude)
                            return oldFindPartOnRayWithIgnore(ws, newRay, ignoreList, terrainCellsAreCubes, ignoreWater)
                        end
                    end
                    return oldFindPartOnRayWithIgnore(ws, ray, ignoreList, terrainCellsAreCubes, ignoreWater)
                end)
            end)

            pcall(function()
                local oldFindPartOnRayWithWhitelist
                oldFindPartOnRayWithWhitelist = hookfunction(workspace.FindPartOnRayWithWhitelist, function(ws, ray, whitelist, ignoreWater)
                    if config.Aiming.Enabled and lockedHitPart then
                        local mode = config.Aiming.MethodMode or "Raycast"
                        if mode == "FindPartOnRayWithWhitelist" or mode == "All" then
                            local targetPos = getTargetPosition()
                            local newRay = Ray.new(ray.Origin, (targetPos - ray.Origin).Unit * ray.Direction.Magnitude)
                            return oldFindPartOnRayWithWhitelist(ws, newRay, whitelist, ignoreWater)
                        end
                    end
                    return oldFindPartOnRayWithWhitelist(ws, ray, whitelist, ignoreWater)
                end)
            end)

            pcall(function()
                local oldFindPartOnRay
                oldFindPartOnRay = hookfunction(workspace.FindPartOnRay, function(ws, ray, ignoreDescendantsInstance, terrainCellsAreCubes, ignoreWater)
                    if config.Aiming.Enabled and lockedHitPart then
                        local mode = config.Aiming.MethodMode or "Raycast"
                        if mode == "FindPartOnRay" or mode == "All" then
                            local targetPos = getTargetPosition()
                            local newRay = Ray.new(ray.Origin, (targetPos - ray.Origin).Unit * ray.Direction.Magnitude)
                            return oldFindPartOnRay(ws, newRay, ignoreDescendantsInstance, terrainCellsAreCubes, ignoreWater)
                        end
                    end
                    return oldFindPartOnRay(ws, ray, ignoreDescendantsInstance, terrainCellsAreCubes, ignoreWater)
                end)
            end)

            pcall(function()
                local oldScreenPoint
                oldScreenPoint = hookfunction(camera.ScreenPointToRay, function(cam, x, y, depth)
                    if config.Aiming.Enabled and lockedHitPart then
                        local mode = config.Aiming.MethodMode or "Raycast"
                        if mode == "ScreenPointToRay" or mode == "All" then
                            local targetPos = getTargetPosition()
                            return Ray.new(cam.CFrame.Position, (targetPos - cam.CFrame.Position).Unit * 1000)
                        end
                    end
                    return oldScreenPoint(cam, x, y, depth)
                end)
            end)

            pcall(function()
                local oldViewportPoint
                oldViewportPoint = hookfunction(camera.ViewportPointToRay, function(cam, x, y, depth)
                    if config.Aiming.Enabled and lockedHitPart then
                        local mode = config.Aiming.MethodMode or "Raycast"
                        if mode == "ViewportPointToRay" or mode == "All" then
                            local targetPos = getTargetPosition()
                            return Ray.new(cam.CFrame.Position, (targetPos - cam.CFrame.Position).Unit * 1000)
                        end
                    end
                    return oldViewportPoint(cam, x, y, depth)
                end)
            end)

            pcall(function()
                local mt = getrawmetatable(game)
                setreadonly(mt, false)
                local oldNamecall = mt.__namecall

                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    local args = {...}

                    if config.Aiming.Enabled and lockedHitPart then
                        local mode = config.Aiming.MethodMode or "Raycast"
                        if mode == "Mouse.Hit" or mode == "Mouse.Target" or mode == "All" or method == "FireServer" or method == "InvokeServer" then
                            if method == "FireServer" or method == "InvokeServer" then
                                local targetPos = getTargetPosition()
                                for i, arg in ipairs(args) do
                                    local t = typeof(arg)
                                    if t == "Vector3" then
                                        args[i] = targetPos
                                    elseif t == "CFrame" then
                                        args[i] = CFrame.new(arg.Position, targetPos)
                                    elseif t == "table" then
                                        for k, v in pairs(arg) do
                                            if typeof(v) == "Vector3" then
                                                arg[k] = targetPos
                                            elseif typeof(v) == "CFrame" then
                                                arg[k] = CFrame.new(v.Position, targetPos)
                                            end
                                        end
                                    end
                                end
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end

                    return oldNamecall(self, ...)
                end)
            end)
        end
    end
end)

